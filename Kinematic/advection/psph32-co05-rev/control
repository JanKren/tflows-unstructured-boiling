#-----------------------------------------------------------------------------
#  Standard advection tests with the production CICSAM (CAF review, 2.8).
#  No momentum, pressure or energy solve (zero outer iterations); the face
#  fluxes are imposed in User_Mod_Beginning_Of_Compute_Vof, see kinematic.in.
#-----------------------------------------------------------------------------
 PROBLEM_NAME           pcube2n32_dual
 HEAT_TRANSFER          no
 INTERFACE_TRACKING     yes
 TRACK_FRONT            no

 NUMBER_OF_TIME_STEPS   192
 TIME_STEP              0.005208333333333333

 RESULTS_SAVE_INTERVAL        192
 BACKUP_SAVE_INTERVAL         100000000
 SAVE_INITIAL_CONDITION       no
 SAVE_RESULTS_AT_BOUNDARIES   no

 NUMBER_OF_MONITORING_POINTS    0
 POINT_FOR_MONITORING_PLANES    0.5  0.5  0.5

 PHASE_DENSITIES          1.0   1.0
 PHASE_VISCOSITIES        1.0   1.0
 SURFACE_TENSION          0.0
 TURBULENCE_MODEL         none
 GRAVITATIONAL_VECTOR     0.0 0.0 0.0

 PRESSURE_MOMENTUM_COUPLING   simple
 MIN_SIMPLE_ITERATIONS        0
 MAX_SIMPLE_ITERATIONS        0

 TIME_INTEGRATION_SCHEME      linear
 ADVECTION_SCHEME_FOR_VOF     cicsam

# Production volume-fraction numerics; MAX_COURANT_VOF is the threshold above
# which the solver sub-cycles the volume-fraction step (default 0.25)
 PRECONDITIONER_FOR_SYSTEM_MATRIX        incomplete_cholesky
 TOLERANCE_FOR_VOF_SOLVER                1.e-8
 MAX_SMOOTHING_CYCLES_CURVATURE_VOF     12
 MAX_SMOOTHING_CYCLES_NORMAL_VOF         0
 GRADIENT_METHOD_FOR_VOF             gauss_theorem
 TOLERANCE_FOR_GAUSS_GRADIENTS       1.0e-4
 MAX_COURANT_VOF                     0.25

  INITIAL_CONDITION
    VARIABLES           u     v     w     vof
    VALUES              0.0   0.0   0.0   1.0

  BOUNDARY_CONDITION    inflow
    TYPE                inflow
    VARIABLES           u     v     w     vof
    VALUES              0.0   0.0   0.0   1.0

# Type inflow on the high faces too: the flow reverses at half time, and an
# outflow-type face with flow into the domain is unstable in the small
# boundary cells of the dual (the hexahedral run is unaffected)
  BOUNDARY_CONDITION    outflow
    TYPE                inflow
    VARIABLES           u     v     w     vof
    VALUES              0.0   0.0   0.0   1.0

  BOUNDARY_CONDITION    sym
    TYPE                symmetry
    VARIABLES           u     v     w     vof
    VALUES              0.0   0.0   0.0   1.0

  BOUNDARY_CONDITION    wall
    TYPE                wall
    VARIABLES           u     v     w     vof
    VALUES              0.0   0.0   0.0   1.0
