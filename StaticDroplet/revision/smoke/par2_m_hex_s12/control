    TYPE                wall
    VARIABLES           u     v     w     vof     vof_c_ang
    VALUES              0.0   0.0   0.0   0.0     90.0

#--- Rhie-Chow and curvature settings, as in the quasi-2D study ------
 GU_CORRECTION                        yes
