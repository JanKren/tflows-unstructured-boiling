#-----------------------------------------------------------
# Capillary limit dt <= sqrt((rho_L+rho_G) h^3 / (8 sigma))
#   h        = 0.03125
#   dt_max   = 2.2553e-05
#   dt/dt_max = 0.16
#-----------------------------------------------------------
