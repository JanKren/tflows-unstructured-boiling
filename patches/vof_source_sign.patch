diff --git a/Sources/Process/Cpu/Vof_Mod/Utilities/Mass_Transfer_Vof_Source.f90 b/Sources/Process/Cpu/Vof_Mod/Utilities/Mass_Transfer_Vof_Source.f90
index 88ef7f8f60..eebb88c86f 100644
--- a/Sources/Process/Cpu/Vof_Mod/Utilities/Mass_Transfer_Vof_Source.f90
+++ b/Sources/Process/Cpu/Vof_Mod/Utilities/Mass_Transfer_Vof_Source.f90
@@ -1,9 +1,9 @@
 !==============================================================================!
   subroutine Mass_Transfer_Vof_Source(Vof, b)
 !------------------------------------------------------------------------------!
-!   Calculates pressure source due to phase change                             !
+!   Phase-change source of the volume-fraction equation                        !
 !                                                                              !
-!   Called from Multiphase_Mod_Vof_Pressure_Correction                         !
+!   Called from Vof_Mod/Core/Discretize                                        !
 !------------------------------------------------------------------------------!
   implicit none
 !---------------------------------[Arguments]----------------------------------!
@@ -29,25 +29,27 @@
   !   Volume source   !
   !-------------------!
 
-  ! Here is the trick to get the sign correct:
-  ! - if gas is 1 and liquid 2 => liquid-vapour =  1 => source > 0
-  ! - if gas is 2 and liquid 1 => liquid-vapour = -1 => source < 0
+  ! The colour function is the volume fraction of phase 1, the liquid in
+  ! every case with phase change (the denser phase listed second, so that
+  ! liquid - vapour = 1).  Evaporation (m_dot > 0) consumes liquid: the
+  ! equation of the liquid fraction carries -m_dot / rho_l, beside the
+  ! expansion m_dot (1/rho_v - 1/rho_l) that Mass_Transfer_Pressure_Source
+  ! puts into the divergence of the face fluxes.  With this sign the mass
+  ! in the domain plus the mass through the outflow stays constant.  With
+  ! the opposite one, which this routine had until November 2026, each
+  ! kilogram evaporated left two kilograms of liquid behind, a mass error
+  ! of 2 rho_v / rho_l of the mass expelled and a relative 2 rho_v / rho_l
+  ! in the interface velocity.
+  !
+  ! Were the vapour phase 1, the colour would be the vapour fraction and
+  ! its source +m_dot / rho_v, which the expression below does not give.
   do c = Cells_In_Domain_And_Buffers()
     e = Vof % Front % elem_in_cell(c)  ! front element
 
-    ! As Yohei and Lubomir adamantly told me - you divide with the density
-    ! of the phase for "which you are solving".  And you are solving for
-    ! the one which is defined as one (not zero) in the system
-    !
-    ! I have certain reservations about the sign (liquid-vapour).  Since the
-    ! term is divided by liquid density, it is very small by definition.
-    ! Also, when I changed definition of phases from 1:2 to 0:1, the results
-    ! were not affected at all, but they should have been.
     if(e .ne. 0) then
       b(c) = b(c)                              &
-           + Vof % m_dot(c) * (liquid-vapour)  &
+           - Vof % m_dot(c) * (liquid-vapour)  &
            * (1.0/Vof % phase_dens(liquid))
-!          * (1.0/Vof % phase_dens(vapour) - 1.0/Vof % phase_dens(liquid))
     end if
   end do
 
